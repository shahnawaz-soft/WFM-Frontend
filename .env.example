# Developer-only backend selection. Copy to .env.local (git-ignored).
# Local Django: leave empty to use the Vite proxy below.
VITE_API_BASE_URL=
# Staging: set the line above to https://steelo-api.staging.steel.study instead.
# Restart the dev server after changing this value.

# Where the dev proxy sends /api and /health (default http://localhost:8000).
VITE_DEV_API_PROXY=http://localhost:8000
