# Local development. Copy to .env.local (git-ignored).
# Leave VITE_API_BASE_URL empty locally: requests go to /api and /health on the Vite dev
# server, which proxies them to Django.
VITE_API_BASE_URL=
# Where the dev proxy sends /api and /health (default http://localhost:8000).
VITE_DEV_API_PROXY=http://localhost:8000
